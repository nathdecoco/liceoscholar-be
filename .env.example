# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the real values.
# .env is gitignored and must never be committed.
# ---------------------------------------------------------------------------

# ---- Required -------------------------------------------------------------

# MongoDB Atlas connection string (Atlas -> Database -> Connect -> Drivers).
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/liceoscholar?retryWrites=true&w=majority

# Signing key for login tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Server ---------------------------------------------------------------

PORT=4000
NODE_ENV=development

# Browser origins allowed to call the API, comma separated.
# Local:      http://localhost:4200
# Deployed:   the frontend URL, e.g. https://liceoscholar.vercel.app
CORS_ORIGINS=http://localhost:4200

# Web app URL, used for the links inside verification emails.
APP_PUBLIC_URL=http://localhost:4200

# ---- Seed accounts --------------------------------------------------------

# Keep false in production so demo students are never created.
SEED_ON_START=true
ADMIN_USERNAME=authorizedadminscholar
ADMIN_PASSWORD=AdminScholar2026
SEED_STUDENT_PASSWORD=Scholar123

# ---- Email (SMTP) ---------------------------------------------------------

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your.address@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=LiceoSCholar <your.address@gmail.com>

EMAIL_VERIFICATION_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=3
PASSWORD_RESET_RESEND_SECONDS=60

# ---- Uploads --------------------------------------------------------------

# Files are stored in MongoDB GridFS, not on disk, so they survive deploys.
MAX_UPLOAD_MB=12

# ---- AI review (Google Gemini) -------------------------------------------

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_TIMEOUT_MS=120000
GEMINI_MAX_FILE_MB=8
